{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@routes/*": ["routes/*"],
      "@middleware/*": ["middleware/*"],
      "@lib/*": ["lib/*"],
      "@config/*": ["config/*"]
    }
  },
  "include": ["**/*.js"],
  "exclude": ["node_modules", "uploads", "data"]
}
