# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase Admin SDK
# Download from Firebase Console > Project Settings > Service Accounts
# Generate new private key and save as firebase-service-key.json in server directory
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# API Key Encryption
# CRITICAL: Generate a secure 64-character hex key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DO NOT use the default key in production!
API_KEY_ENCRYPTION_KEY=your-64-character-hex-encryption-key-here

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Firebase Service Account Key File Path
# If not set, defaults to 'firebase-service-key.json' in server directory
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-key.json
