# =============================================================================
# Cloud Storage Server Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Firebase Admin SDK
# Download from Firebase Console > Project Settings > Service Accounts
# Generate new private key and save as firebase-service-key.json in server directory
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# API Key Encryption (CRITICAL)
# MUST be exactly 64 hexadecimal characters (32 bytes = AES-256 key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Example: 5e80c9807a80fefc16873e0b81a9b17459dcf65f6a3e6ffa26e60342273f4a18
# 
# ⚠️ WARNING: 
# - Changing this key will invalidate all existing API keys
# - Store this key securely - it cannot be recovered if lost
# - DO NOT commit this to version control
# -----------------------------------------------------------------------------
API_KEY_ENCRYPTION_KEY=your-64-character-hex-encryption-key-here

# -----------------------------------------------------------------------------
# CORS Configuration
# Comma-separated list of allowed origins
# Supports wildcards: *.example.com
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Optional: Firebase Service Account Key File Path
# If not set, defaults to 'firebase-service-key.json' in server directory
# -----------------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-key.json

# =============================================================================
# Video Transcoding & Streaming Configuration
# =============================================================================
# Enable/disable video transcoding for streaming optimization
# Requires ffmpeg installed on the system
# -----------------------------------------------------------------------------
TRANSCODE_ENABLED=true

# Keep original file after transcoding
# If false, original file is deleted after successful transcode (saves storage)
# Default: true (keep original for download)
# -----------------------------------------------------------------------------
TRANSCODE_KEEP_ORIGINAL=true

# Only transcode non-MP4 files
# MP4 files are already web-compatible, skip transcoding to save resources
# Set to false to transcode all video formats
# Default: true (skip MP4/WebM)
# -----------------------------------------------------------------------------
TRANSCODE_ONLY_NON_MP4=true

# Default transcoding quality
# Options: 480p, 720p, 1080p
# Higher quality = larger file size, more bandwidth
# Default: 720p (good balance of quality and size)
# -----------------------------------------------------------------------------
TRANSCODE_QUALITY=720p

# Directory for storing transcoded video cache
# Default: server/transcode-cache
# -----------------------------------------------------------------------------
# TRANSCODE_CACHE_DIR=/path/to/transcode-cache

# -----------------------------------------------------------------------------
# Notes:
# - Transcoding requires ffmpeg: sudo apt-get install ffmpeg (Linux)
# - On macOS: brew install ffmpeg
# - On Windows: Download from https://ffmpeg.org/download.html
# - First stream of non-MP4 video will be slower (on-demand transcoding)
# - Subsequent streams use cached transcoded version
# =============================================================================
