# =============================================================================
# Cloud Storage Server Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Firebase Admin SDK
# Download from Firebase Console > Project Settings > Service Accounts
# Generate new private key and save as firebase-service-key.json in server directory
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# API Key Encryption (CRITICAL)
# MUST be exactly 64 hexadecimal characters (32 bytes = AES-256 key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Example: 5e80c9807a80fefc16873e0b81a9b17459dcf65f6a3e6ffa26e60342273f4a18
# 
# ⚠️ WARNING: 
# - Changing this key will invalidate all existing API keys
# - Store this key securely - it cannot be recovered if lost
# - DO NOT commit this to version control
# -----------------------------------------------------------------------------
API_KEY_ENCRYPTION_KEY=your-64-character-hex-encryption-key-here

# -----------------------------------------------------------------------------
# CORS Configuration
# Comma-separated list of allowed origins
# Supports wildcards: *.example.com
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Optional: Firebase Service Account Key File Path
# If not set, defaults to 'firebase-service-key.json' in server directory
# -----------------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-key.json
